TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DATABASE_URL=postgresql+asyncpg://telegram_feed:telegram_feed@localhost:5432/telegram_feed
DATABASE_URL_SYNC=postgresql://telegram_feed:telegram_feed@localhost:5432/telegram_feed
REDIS_URL=redis://localhost:6379/0

# Public URL where your hosted privacy policy lives (see PRIVACY.md).
# Also register this URL in @BotFather (Bot Settings -> Privacy Policy).
# /privacy falls back to a built-in summary when this is blank.
PRIVACY_POLICY_URL=

# Data retention (hours/days). Must exceed the longest digest window. 0 disables.
POST_RETENTION_HOURS=72
DIGEST_RUN_RETENTION_DAYS=30
